# GitHub personal access token (public_repo read is enough).
# Unauthenticated requests are limited to 60/hour; with a token: 5000/hour.
GITHUB_TOKEN=

# TypeSafe / Jev API key. Leave empty to run in heuristic (offline) judge mode.
TYPESAFE_API_KEY=

# Jev model alias
JEV_MODEL=jev-latest

# Jev API endpoint
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# Where SQLite + project context live
DATA_DIR=./data

# Scan scope
SCAN_LOOKBACK_DAYS=365
MAX_ISSUES=400
MAX_PRS=200
MAX_DISCUSSIONS=100
MAX_COMMENT_FETCHES=300
MAX_TIMELINE_FETCHES=12
MAX_PULL_DETAILS=8
GITHUB_MIN_BUDGET=20

# Embedding backend: tfidf (default, zero downloads) or sentence-transformers
EMBEDDING_BACKEND=tfidf
